<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SosaFam.Database</AssemblyName>
  </PropertyGroup>

  <!-- Migrations/ at the repository root is embedded, so one build carries every migration.
       Files that start with an underscore (the template) are not migrations. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\Migrations\*.sql" Exclude="..\..\Migrations\_*.sql" LogicalName="Migrations/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

</Project>
